{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/wallet",
      "destination": "/",
      "statusCode": 307,
      "regex": "^(?!/_next)/wallet(?:/)?$"
    },
    {
      "source": "/trips",
      "destination": "/",
      "statusCode": 307,
      "regex": "^(?!/_next)/trips(?:/)?$"
    },
    {
      "source": "/flights",
      "destination": "/",
      "statusCode": 307,
      "regex": "^(?!/_next)/flights(?:/)?$"
    },
    {
      "source": "/bus",
