4b:["$","div","How does Trayago's train tracker work?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"How does Trayago's train tracker work?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"Enter a train number and select Track Live. Trayago loads the current running information for that train and shows a journey timeline with station timings and delay information. Recently tracked train numbers are saved in your browser so you can return to them quickly."}]]}]
4c:["$","div","What is a train destination wake-up alarm?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"What is a train destination wake-up alarm?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"It is an alert tied to the last station on your train's journey timeline. Once enabled for a tracked train, Trayago monitors the journey's progress and alerts you as the train approaches your destination, so you have time to gather your luggage and prepare to get off."}]]}]
4d:["$","div","Can Trayago alert me before I reach my destination?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"Can Trayago alert me before I reach my destination?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"Yes. Enable the destination wake-up alarm after tracking your train. The alert is designed to reach you as the train nears the destination station rather than at the moment of arrival. Keep the tab open for the alarm to remain active."}]]}]
4e:["$","div","Does Trayago guarantee exact arrival times?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"Does Trayago guarantee exact arrival times?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"No. Timings shown are based on the scheduled timetable and the latest reported running information, and a train's delay can change while it is en route. Treat arrival estimates and alarm timing as guidance, and confirm platform numbers with official station announcements."}]]}]
4f:["$","div","How is the train tracker different from live train running status?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"How is the train tracker different from live train running status?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"The tracker is built around following a journey you are on, with the destination wake-up alarm and quick access to recently tracked trains. Live train running status focuses on checking a train's current status in detail, including a map view, date selection, and auto-refreshing station information."}]]}]
50:["$","div",null,{"className":"space-y-3 border-t border-subtle pt-8","children":[["$","h3",null,{"className":"text-base font-bold text-main","children":"Related tools"}],["$","p",null,{"children":["For a detailed view with a map, date selection and auto-refreshing station information, use"," ",["$","$L2e",null,{"href":"/live","className":"text-primary font-semibold hover:underline","children":"live train running status"}],". You can also check a booking with"," ",["$","$L2e",null,{"href":"/pnr","className":"text-primary font-semibold hover:underline","children":"PNR status and confirmation prediction"}],", plan a route with the"," ",["$","$L2e",null,{"href":"/","className":"text-primary font-semibold hover:underline","children":"Trayago train search"}],", break a long route into connecting segments with the"," ",["$","$L2e",null,{"href":"/split-journey","className":"text-primary font-semibold hover:underline","children":"AI split journey planner"}],", check approved station catering prices in the"," ",["$","$L2e",null,{"href":"/rate-list","className":"text-primary font-semibold hover:underline","children":"IRCTC station rate list"}],", or track journeys on the"," ",["$","$L2e",null,{"href":"/app","className":"text-primary font-semibold hover:underline","children":"Trayago Android app"}],"."]}],["$","p",null,{"className":"text-xs text-muted","children":"Trayago is an independent travel intelligence platform and is not affiliated with, endorsed by, or operated by IRCTC or Indian Railways. Ticket booking is completed through official booking platforms."}]]}]
