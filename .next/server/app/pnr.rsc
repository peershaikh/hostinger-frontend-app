41:["$","section",null,{"aria-labelledby":"pnr-guide-heading","className":"w-full px-4 md:px-8 pb-16","children":["$","div",null,{"className":"max-w-4xl mx-auto w-full border-t border-strong pt-12 space-y-10 text-sm text-secondary leading-relaxed","children":[["$","div",null,{"className":"space-y-4","children":[["$","h2",null,{"id":"pnr-guide-heading","className":"text-xl font-black text-main","children":"PNR Status Check & Confirmation Prediction"}],["$","p",null,{"children":["Every reserved Indian Railways ticket carries a 10-digit"," ",["$","strong",null,{"children":"PNR number"}]," that records who is travelling, on which train, and in which class. Checking the"," ",["$","strong",null,{"children":"PNR status"}]," tells you the current booking status for each passenger on that ticket — confirmed, RAC, or still waitlisted — plus coach and berth details once they have been allotted."]}],["$","p",null,{"children":["Trayago reads the latest status for your PNR and, where a waitlist position exists, adds a"," ",["$","strong",null,{"children":"PNR confirmation probability"}]," estimate derived from historical booking and cancellation patterns. The estimate is a statistical projection to help you plan — it is not a decision by Indian Railways, and confirmation cannot be guaranteed."]}]]}],["$","div",null,{"className":"space-y-3","children":[["$","h3",null,{"className":"text-base font-bold text-main","children":"How to check PNR status online"}],["$","ol",null,{"className":"list-decimal pl-5 space-y-2","children":[["$","li",null,{"children":"Enter the 10-digit PNR number from your ticket in the field at the top of this page."}],["$","li",null,{"children":["Select ",["$","strong",null,{"children":"Check Status"}],". Trayago fetches the current ",["$","strong",null,{"children":"train ticket status"}]," for that booking."]}],["$","li",null,{"children":"Review the passenger-wise booking status, chart preparation state, and the confirmation probability estimate where one is available."}]]}],["$","p",null,{"children":["No account and no IRCTC login is needed, and checking"," ",["$","strong",null,{"children":"railway PNR status"}]," on Trayago is free."]}]]}],["$","div",null,{"className":"space-y-3","children":[["$","h3",null,{"className":"text-base font-bold text-main","children":"Understanding CNF, RAC and WL"}],["$","ul",null,{"className":"space-y-2 pl-5 list-disc","children":[["$","li",null,{"children":[["$","strong",null,{"children":"CNF"}]," — Confirmed. A berth or seat is reserved for the passenger. Coach and berth numbers appear once the reservation chart is prepared."]}],["$","li",null,{"children":[["$","strong",null,{"children":"RAC"}]," — Reservation Against Cancellation. The passenger may board and is allotted a shared side berth. RAC can move to confirmed if berths free up."]}],["$","li",null,{"children":[["$","strong",null,{"children":"WL"}]," — Waitlist. No berth is allotted yet; the queue position is shown as a number, such as GNWL 12 or PQWL 5. A ticket still on the ",["$","strong",null,{"children":"waitlist"}]," after the final chart is generally not valid for travel in a reserved coach."]}]]}],["$","p",null,{"children":[["$","strong",null,{"children":"Chart preparation"}]," usually happens a few hours before departure and is the point at which berth allocation is finalised. Status movement is far more likely before the chart is prepared than after it."]}]]}],["$","div",null,{"className":"space-y-3","children":[["$","h3",null,{"className":"text-base font-bold text-main","children":"How PNR confirmation prediction works"}],["$","p",null,{"children":["Trayago's ",["$","strong",null,{"children":"PNR prediction"}]," compares your current waitlist position against how similar bookings have behaved historically on the same train, class, quota, and route, factoring in travel date and seasonal demand. The output is a probability band rather than a yes or no answer."]}],"$L51"]}],"$L52","$L53"]}]}]
