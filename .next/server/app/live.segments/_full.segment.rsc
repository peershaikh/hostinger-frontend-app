50:["$","div","Can I see where my train is right now?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"Can I see where my train is right now?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"Trayago shows the train's position along its route based on the latest reported running information, so you can see which stations it has passed and which are still ahead. This reflects the most recent update available rather than continuous second-by-second positioning."}]]}]
51:["$","div","How are train delays shown?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"How are train delays shown?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"Delay is shown as the difference in minutes between the scheduled timetable and the latest reported running information. A train reported at or ahead of schedule is marked as on time, and a train behind schedule shows how many minutes late it is currently running."}]]}]
52:["$","div","What does ETA mean in live train status?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"What does ETA mean in live train status?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"ETA is the estimated time of arrival at a station. Trayago derives it by applying the current delay to the scheduled arrival time for each upcoming station. Because delays can grow or shrink while a train is running, an ETA is an estimate and can shift during the journey."}]]}]
53:["$","div","How often does live train running status update?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"How often does live train running status update?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"Trayago refreshes the running information for a tracked train automatically about every 30 seconds while the page is open, and applies live updates as they are received. The underlying railway data itself changes only when the train reports at a location, so the displayed position may stay the same between reports."}]]}]
54:["$","div","Can train timings change after I check the status?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"Can train timings change after I check the status?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"Yes. Running information, delay, platform assignment, and estimated timings can all change while a train is en route due to traffic, signalling, or operational decisions. Checking again closer to the arrival time gives you the most current picture."}]]}]
55:["$","div","Is live train information always accurate?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"Is live train information always accurate?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"It is as accurate as the latest available railway running data for that train, which means it can lag behind reality between station reports and can occasionally be incomplete for special or newly introduced trains. For platform numbers and last-minute changes, confirm with official station announcements."}]]}]
56:["$","div","What is the 'Inside' vs 'Outside' tracking toggle?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"What is the 'Inside' vs 'Outside' tracking toggle?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"Outside mode uses railway running information to show where the train has been reported. Inside mode is for when you are travelling on the train and uses your own device's GPS to estimate speed and position between station reports, which can help when railway updates are sparse."}]]}]
57:["$","div","Is Trayago affiliated with IRCTC or Indian Railways?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"Is Trayago affiliated with IRCTC or Indian Railways?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"No. Trayago is an independent travel intelligence platform and is not affiliated with, endorsed by, or operated by IRCTC or Indian Railways. Ticket booking is completed through official booking platforms."}]]}]
