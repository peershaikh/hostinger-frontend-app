:"og:type","content":"website"}],["$","meta","14",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","15",{"name":"twitter:title","content":"AI Waitlist Rescue — Trayago"}],["$","meta","16",{"name":"twitter:description","content":"Search split journeys and alternative route combinations when your direct train is waitlisted."}],["$","link","17",{"rel":"icon","href":"/favicon.ico?603d046c9a6fdfbb","type":"image/x-icon","sizes":"16x16"}],["$","link","18",{"rel":"icon","href":"/favicon.svg?v=2","type":"image/svg+xml"}],["$","link","19",{"rel":"icon","href":"/icon-192.png?v=2","sizes":"192x192","type":"image/png"}],["$","link","20",{"rel":"icon","href":"/icon-512.png?v=2","sizes":"512x512","type":"image/png"}],["$","link","21",{"rel":"apple-touch-icon","href":"/icons/apple-touch-icon.png?v=2","sizes":"180x180","type":"image/png"}],["$","link","22",{"rel":"apple-touch-icon","href":"/icon-192.png?v=2","sizes":"192x192","type":"image/png"}],["$","$L12","23",{}]]}]}],null]}],null]}],"p":"$@13","v":null,"s":"$7"}},"a":"$@14","u":"$@15","b":"kFUOMdpitUvFK-CLwL4j1"}
