1e:["$","div","What is a train destination wake-up alarm?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"What is a train destination wake-up alarm?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"It is an alert tied to the last station on your train's journey timeline. Once enabled for a tracked train, Trayago monitors the journey's progress and alerts you as the train approaches your destination, so you have time to gather your luggage and prepare to get off."}]]}]
1f:["$","div","Can Trayago alert me before I reach my destination?",{"className":"space-y-1.5","children":[["$","dt",null,{"className":"text-sm font-bold text-main","children":"Can Trayago alert me before I reach my destination?"}],["$","dd",null,{"className":"text-sm text-secondary leading-relaxed","children":"Yes. Enable the destination wake-up alarm after tracking your train. The alert is designed to reach you as the train nears the destination station rather than at the moment of arrival. Keep the tab open for the alarm to remain active."}]]}]
