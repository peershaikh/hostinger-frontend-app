 & Destination Wake-Up Alarm"}],["$","meta","16",{"name":"twitter:description","content":"Track your train journey and get alerted before you reach your destination station."}],["$","link","17",{"rel":"icon","href":"/favicon.ico?603d046c9a6fdfbb","type":"image/x-icon","sizes":"16x16"}],["$","link","18",{"rel":"icon","href":"/favicon.svg?v=2","type":"image/svg+xml"}],["$","link","19",{"rel":"icon","href":"/icon-192.png?v=2","sizes":"192x192","type":"image/png"}],["$","link","20",{"rel":"icon","href":"/icon-512.png?v=2","sizes":"512x512","type":"image/png"}],["$","link","21",{"rel":"apple-touch-icon","href":"/icons/apple-touch-icon.png?v=2","sizes":"180x180","type":"image/png"}],["$","link","22",{"rel":"apple-touch-icon","href":"/icon-192.png?v=2","sizes":"192x192","type":"image/png"}],["$","$L13","23",{}]]}]}],null]}],null]}],"p":"$@14","v":null,"s":"$7"}},"a":"$@15","u":"$@16","b":"DepLdmuNW8z-zG1kors1a"}
