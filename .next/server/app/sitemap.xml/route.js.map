/* single sitemap route */
import { NextResponse } from 'next/server'
import { default as handler } from "D:\\Data Tarine\\trine\\web\\src\\app\\sitemap.ts"
import { resolveRouteData } from 'next/dist/build/webpack/loaders/metadata/resolve-route-data'

const contentType = "application/xml"
const fileType = "sitemap"


  if (typeof handler !== 'function') {
    throw new Error('Default export is missing in "D:\\Data Tarine\\trine\\web\\src\\app\\sitemap.ts"')
  }
  


export async function GET() {
  const data = await handler()
  const content = resolveRouteData(data, fileType)

  return new NextResponse(content, {
    headers: {
      'Content-Type': contentType,
      'Cache-Control': "public, max-age=0, must-revalidate",
    },
  })
}
