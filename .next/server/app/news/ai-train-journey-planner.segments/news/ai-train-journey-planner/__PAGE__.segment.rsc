1d:["$","section",null,{"className":"mb-10","children":[["$","h2",null,{"className":"text-xl sm:text-2xl font-bold text-main mb-4 flex items-center gap-2","children":[["$","$L1c",null,{"iconNode":"$d:props:children:1:props:children:2:props:children:1:props:children:0:props:iconNode","className":"lucide-tram-front w-6 h-6 text-blue-500 shrink-0"}],"What Is Trayago?"]}],["$","p",null,{"className":"text-sm sm:text-base text-main leading-relaxed mb-4","children":"Trayago is an independent travel intelligence platform for Indian train travellers. It is not affiliated with IRCTC or Indian Railways, and it does not issue or manage railway tickets. Ticket booking is completed through official railway booking platforms such as IRCTC."}],["$","p",null,{"className":"text-sm sm:text-base text-main leading-relaxed mb-4","children":"What it offers is a layer of intelligence on top of the railway network: AI-powered route analysis, alternative journey discovery, live train running status, PNR status checking, confirmation probability estimates, and train schedule data across India."}],["$","p",null,{"className":"text-sm sm:text-base text-main leading-relaxed","children":"The platform is designed for anyone who has struggled with a waitlisted ticket, a last-minute booking, or the challenge of finding a practical route when the obvious direct option is unavailable. Trayago brings together the tools needed to plan smarter — and travel with more confidence."}]]}]
